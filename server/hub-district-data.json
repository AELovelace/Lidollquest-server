      "npcs": [
        {
          "avatar": "objNPCGuard",
          "name": "Gate Inspector Holloway",
          "line": "Papers? No? Then state your business in Arcadia, plainly and in a grown-up voice. The Guildhall is dead ahead, the Boarding House is east, the Rail Depot is west. And keep off the tracks."
        },
        {
          "avatar": "objNPCBlacksmith",
          "name": "Foreman Grist",
          "line": "Twelve-hour shifts, one whistle for lunch, and no stopping the line for anyone who can't hold it. That's how a city gets built."
        },
        {
          "avatar": "objNPCCorporalVex",
          "name": "Constable Brask",
          "line": "Arcadia's orderly and it's staying that way. Anyone making a puddle on my cobbles spends the night in the cells, crinkle or no crinkle."
        },
        {
          "avatar": "objNPCLunchLady",
          "name": "Madam Coalby",
          "line": "Hot pies, a penny each. Not for you, sweetheart. Bigs only at the counter; littles round the back, if there's anything left."
        },
        {
          "id": "arcadia-bootblack",
          "avatar": "objNPCWaddlingKid",
          "name": "Tuppence, Boot-Black",
          "line": "Shine, mister? Shine? ...They never look down, the bigs. Suits me. Nobody notices a little down here, not even when she's soggy.",
          "roaming": true
        },
        {
          "id": "arcadia-sweep",
          "avatar": "objNPCLostChild",
          "name": "Sooty, Chimney Sweep",
          "line": "They send me up the stacks 'cause I'm small. Coughing all day, and no stopping to go, so I just... don't stop. The soot hides most of it.",
          "roaming": true
        },
        {
          "id": "arcadia-coalrunner",
          "avatar": "objNPCNewKid",
          "name": "Nibs, Coal-Runner",
          "line": "Heard there's a city up north where littles run everything and nobody laughs at your padding. Bet it's made up. Bet it's lovely, though.",
          "roaming": true
        },
        {
          "id": "arcadia-inspector",
          "avatar": "objNPCWhistleblower",
          "name": "Mr. Ratchet, Smog Inspector",
          "line": "Smog levels: acceptable. Whistle schedule: acceptable. You: under review. Stand up straight and stop fidgeting.",
          "roaming": true
        }
      ],
