NODE_ENV=production
# Optional protected join feed for MommyBot; set the same dedicated secret on both services.
# MOMMYBOT_ONLINE_TOKEN=<32-to-128-URL-safe-random-characters>
# Optional gamemaster panel at GET /gm; unset leaves the whole staff surface returning 503.
# Keep this off the public internet: bind HOST to loopback or front it with an authenticated proxy.
# LIDOLLQUEST_GM_TOKEN=<32-to-128-URL-safe-random-characters>
HOST=127.0.0.1
PORT=4191
DATA_DIR=/var/lib/lidollquest-server
# Maximum assembled campaign save; individual requests remain limited to 256 KiB.
QUEST_CLOUD_MAX_BYTES=67108864
LIDOLLCOIN_API_URL=http://127.0.0.1:4173/tracker/api/lidollcoin/v1/
# Match the tracker LIDOLLCOIN_REWARD_KEYS.lidollquest entry; never ship this key in the game.
# Leave unset until provisioning; the helper adds LIDOLLCOIN_REWARD_KEY automatically.
