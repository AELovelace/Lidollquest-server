NODE_ENV=production
# Optional protected join feed for MommyBot; set the same dedicated secret on both services.
# MOMMYBOT_ONLINE_TOKEN=<32-to-128-URL-safe-random-characters>
# Gamemaster panel at GET /gm. Access requires a LiDollID account holding the 'gamemaster'
# role in Little Log user management; there is no shared panel secret to distribute or rotate.
# Set this to false to remove the staff surface entirely.
# LIDOLLQUEST_GM_ENABLED=false
# Which hosts may reach /gm: comma-separated IPs and/or CIDR blocks. A headless server needs
# a HOST the operator's machine can reach, so list that machine here. Unset applies no address
# restriction, leaving the gamemaster role as the only barrier.
# LIDOLLQUEST_GM_ALLOW=10.1.1.23
# Refuse /gm unless the request reached the operator over HTTPS. Requires the proxy below,
# because only a trusted proxy's X-Forwarded-Proto is believed.
# LIDOLLQUEST_GM_REQUIRE_TLS=true
# The reverse proxy in front of /gm, as IPs and/or CIDR blocks. Its X-Forwarded-Proto and
# X-Forwarded-For are trusted; every other caller's are ignored. Leave unset when there is none.
# LIDOLLQUEST_GM_TRUST_PROXY=10.1.1.20
# Ship a quest pack as boot content: the named file's quests are live as soon as the
# service starts, with no gamemaster sign-in and no upload. The panel can still edit or
# retire any of them, because a saved row overlays the shipped one.
# Set this only once quest-capable clients are published: any live quest refuses clients
# that do not send quest_version:1. Unset means no live quests.
# LIDOLLQUEST_QUEST_PACK=content/weekly_quests.json
HOST=127.0.0.1
PORT=4191
DATA_DIR=/var/lib/lidollquest-server
# One shared world: zone-affined snapshot/encoding workers read the coordinator's WAL database.
# auto uses min(4, available CPU cores - 2); 0 restores coordinator-only snapshots.
QUEST_ZONE_WORKERS=5
# Maximum active accounts per zone; unset or blank defaults to 256. Restart after changing.
# Admission checks and player visibility use the same positive integer capacity.
QUEST_ZONE_CAPACITY=256
# auto uses remaining cores after zone workers, capped at 6, with 2 cores reserved.
# Production's 12 cores: 5 zone + 5 generation/pathfinding workers, leaving 2 cores of headroom.
# Existing /etc/lidollquest/server.env is preserved on redeploy; set both values there too.
QUEST_COMPUTE_WORKERS=5
# Reuse a player's successful LiDollID login for this many milliseconds instead of asking the
# tracker on every step and poll. Suspensions are still checked every request, failed logins are
# never reused, /gm always re-checks, and reconnecting issues a new token. 0 disables; max 600000.
QUEST_AUTH_CACHE_MS=30000
# Premium private sprite generation uses PixelLab independently of the CPU worker pool.
# Add your provider token to /etc/lidollquest/server.env, then restart the service.
# Without it, saved collections work but the game reports generation is not configured.
# PIXELLAB_API_TOKEN=<your-private-provider-token>
# PIXELLAB_PYTHON=/usr/bin/python3
# Maximum assembled campaign save; individual requests remain limited to 256 KiB.
QUEST_CLOUD_MAX_BYTES=67108864
LIDOLLCOIN_API_URL=http://127.0.0.1:4173/tracker/api/lidollcoin/v1/
# Match the tracker LIDOLLCOIN_REWARD_KEYS.lidollquest entry; never ship this key in the game.
# Leave unset until provisioning; the helper adds LIDOLLCOIN_REWARD_KEY automatically.
# Tutor NPC ("Pip", server/tutor.mjs): a guide beside the spawn of every starting lobby who answers
# players' questions from the player wiki. Answers come from the npc-rag service on the AI server
# (C:/Scripts/npc-rag, port 9092). Unset NPC_RAG_URL inherits QUEST_FOLLOWER_AGENT_URL (or :9092 below).
# An explicitly empty URL hides Pip; the /gm Tutor NPC tab can switch him off, rename him and edit his greeting.
# The AI server's firewall must let this host reach port 9092 (Register-NpcRagTasks.ps1 -AllowFrom <this host>).
# NPC_RAG_URL=http://192.168.1.188:9092
# The NPC_API_KEY set in npc-rag's .env; sent as X-Api-Key. Never ship it in the game.
# NPC_RAG_KEY=<same-secret-as-npc-rag-NPC_API_KEY>
# Milliseconds to wait for one answer before retrying once, then giving a friendly "ask me again" line.
# NPC_RAG_TIMEOUT_MS=45000
# Questions per account per UTC day, protecting the AI server from floods.
# TUTOR_DAILY_LIMIT=100

# Hired NPC followers: use a follower_version:1 client. Explicit false disables new recruitment.
QUEST_FOLLOWERS_ENABLED=true
QUEST_FOLLOWER_CLASSIFIER_URL=http://192.168.1.188:9091
QUEST_FOLLOWER_LLM_URL=http://192.168.1.188:9090
QUEST_FOLLOWER_AGENT_URL=http://192.168.1.188:9092
# QUEST_FOLLOWER_AGENT_KEY=<server-only NPC_API_KEY, if configured>

# Deploy flow_version:1 clients before enabling publication. Drafts and tests remain available.
QUEST_FLOWS_ENABLED=false
# Public panel URL ending in /gm; used only by the in-game workshop launcher.
# LIDOLLQUEST_GM_PUBLIC_URL=https://your-public-server/gm

# GM handbook chat: browser -> this game server -> separate GM RAG service (9093).
# Keep the AI firewall limited to this server's public egress IP, not admin devices.
# LIDOLLQUEST_GM_HELP_URL=http://YOUR_AI_SERVER_ADDRESS:9093
# LIDOLLQUEST_GM_HELP_KEY=<same-secret-as-npc-rag-GM_API_KEY>
